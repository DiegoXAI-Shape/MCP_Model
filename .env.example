ANTHROPIC_API_KEY=""

# Solo si usas el proveedor "qwen-local" del panel web: URL y nombre de
# modelo de tu servidor llama.cpp (llama-server) ya corriendo, con soporte
# de tool calling y --reasoning-format deepseek para separar el
# razonamiento. Si no los defines, se usan estos mismos valores por defecto.
LLAMACPP_BASE_URL="http://localhost:8080"
LLAMACPP_MODEL="qwen3.5"
